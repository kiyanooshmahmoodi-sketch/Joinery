rules_version = '2';
// CabLine — Firestore security rules (v474: companies)
// Paste this whole file into Firebase console › Firestore Database › Rules, then press Publish.
//
// Who is who:
//   Owner  = kiyanoosh.mahmoodi@gmail.com — creates companies and their admins, pauses/deletes companies.
//            The Owner has a private workspace (org '__owner') with every section for testing,
//            and can NOT read any company's jobs, quotes, client links or files.
//   Company admin  = users/{email}.orgAdmin == true — manages the people of their own company only.
//   Company member = users/{email}.org == company id, status 'approved'.
// Every job / quote / client link / file carries `org`; people only ever reach their own company's.
// A paused company (orgs/{id}.status == 'suspended') can read but not write.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function isOwner() { return verified() && myEmail() == 'kiyanoosh.mahmoodi@gmail.com'; }

    function meRef() { return /databases/$(database)/documents/users/$(myEmail()); }
    function me() { return get(meRef()).data; }
    function myOrg() { return me().get('org', ''); }
    function orgOf(o) { return get(/databases/$(database)/documents/orgs/$(o)).data; }
    // a real person: confirmed their email, OR joined with the one-time invite code (their account is tied to their record)
    function realUser() {
      return verified() || (signedIn() && request.auth.token.email != null && exists(meRef()) && me().get('uid', '') == request.auth.uid);
    }

    // an approved person of a company that still exists
    function isMember() {
      return realUser() && exists(meRef()) && me().get('status', '') == 'approved'
        && myOrg() != ''
        && exists(/databases/$(database)/documents/orgs/$(myOrg()))
        && orgOf(myOrg()).get('status', '') in ['active', 'suspended'];
    }
    function canWrite() { return isMember() && orgOf(myOrg()).get('status', '') == 'active'; }
    function isOrgAdmin() { return isMember() && me().get('orgAdmin', false) == true; }
    function inMyOrg(d) { return d.get('org', '') == myOrg(); }
    // the Owner's own private workspace (all sections, own test jobs) — never another company's data
    function ownerSpace(d) { return isOwner() && d.get('org', '') == '__owner'; }
    function orgDeleting(o) {
      return exists(/databases/$(database)/documents/orgs/$(o)) && orgOf(o).get('status', '') == 'deleting';
    }
    // sections a company admin may hand out: the company's sections (+ Quotation if the company has it)
    function allowedRoles() {
      return orgOf(myOrg()).get('sections', []).concat(orgOf(myOrg()).get('quote', false) ? ['quote'] : []);
    }

    // ---- Companies: only the Owner manages them; people read their own company
    match /orgs/{o} {
      allow get: if isOwner() || (isMember() && myOrg() == o);
      allow list, create, update, delete: if isOwner();
    }

    // ---- Jobs (and the same for quotes, client links, files): own company only
    match /jobs/{id} {
      allow read: if (isMember() && (resource == null || inMyOrg(resource.data)))
                  || (isOwner() && (resource == null || ownerSpace(resource.data)))
                  || (isOwner() && resource != null && orgDeleting(resource.data.get('org', '')));
      allow create: if (canWrite() && inMyOrg(request.resource.data)) || ownerSpace(request.resource.data);
      allow update: if (canWrite() && inMyOrg(resource.data) && inMyOrg(request.resource.data))
                    || (ownerSpace(resource.data) && ownerSpace(request.resource.data));
      allow delete: if (canWrite() && inMyOrg(resource.data)) || ownerSpace(resource.data)
                    || (isOwner() && orgDeleting(resource.data.get('org', '')));
    }

    // Quotes: only companies that have Quotation, and only their admins or people given Quotation
    function canQuote() {
      return isMember() && orgOf(myOrg()).get('quote', false) == true
        && (isOrgAdmin() || me().get('roles', []).hasAny(['quote']));
    }
    match /quotes/{id} {
      allow read: if (canQuote() && (resource == null || inMyOrg(resource.data)))
                  || (isOwner() && (resource == null || ownerSpace(resource.data)))
                  || (isOwner() && resource != null && orgDeleting(resource.data.get('org', '')));
      allow create, update: if (canQuote() && canWrite() && inMyOrg(request.resource.data)
                            && (resource == null || inMyOrg(resource.data)))
                            || (ownerSpace(request.resource.data) && (resource == null || ownerSpace(resource.data)));
      allow delete: if (canQuote() && canWrite() && inMyOrg(resource.data)) || ownerSpace(resource.data)
                    || (isOwner() && orgDeleting(resource.data.get('org', '')));
    }

    // Shared app settings (hardware names, colours, email setup): everyone signed in reads, only the Owner changes
    match /settings/{id} {
      allow read: if isOwner() || isMember();
      allow write: if isOwner();
    }

    // ---- People
    match /users/{em} {
      allow get: if isOwner() || (realUser() && em == myEmail())
                 || (isOrgAdmin() && inMyOrg(resource.data));
      allow list: if (isOwner() && (resource.data.get('orgAdmin', false) == true || orgDeleting(resource.data.get('org', ''))))
                  || (isOrgAdmin() && inMyOrg(resource.data));
      allow create: if
          // the Owner adds a company admin
          (isOwner() && request.resource.data.get('orgAdmin', false) == true && request.resource.data.get('org', '') != '')
          // a company admin adds a person to their own company, within the company's sections
          || (isOrgAdmin() && inMyOrg(request.resource.data) && request.resource.data.get('orgAdmin', false) == false
              && request.resource.data.get('roles', []).hasOnly(allowedRoles()))
          // someone signs up by themselves: waits, belongs to no company until an admin adds their email
          || (realUser() && em == myEmail() && request.resource.data.get('status', '') == 'pending'
              && request.resource.data.get('roles', []).size() == 0
              && request.resource.data.get('org', '') == '' && request.resource.data.get('orgAdmin', false) == false);
      allow update: if
          (isOwner() && resource.data.get('orgAdmin', false) == true && request.resource.data.get('orgAdmin', false) == true)
          || (isOwner() && resource.data.get('org', '') == '' && request.resource.data.get('orgAdmin', false) == true)
          || (isOrgAdmin() && inMyOrg(resource.data) && inMyOrg(request.resource.data)
              && resource.data.get('orgAdmin', false) == false && request.resource.data.get('orgAdmin', false) == false
              && request.resource.data.get('roles', []).hasOnly(allowedRoles()))
          // a person who signed up by themselves can be added by a company admin
          || (isOrgAdmin() && resource.data.get('org', '') == '' && inMyOrg(request.resource.data)
              && request.resource.data.get('orgAdmin', false) == false
              && request.resource.data.get('roles', []).hasOnly(allowedRoles()))
          // joining with the one-time invite code: the code must match, it is used up, and the account is tied to this record
          || (signedIn() && request.auth.token.email != null && em == myEmail()
              && resource.data.get('codeHash', '') != ''
              && request.resource.data.get('uid', '') == request.auth.uid
              && hashing.sha256(request.resource.data.get('codeProof', '')).toHexString().lower() == resource.data.codeHash
              && !('codeHash' in request.resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'codeProof', 'codeHash', 'joinedAt']))
          // everyone keeps their own "last seen" up to date
          || (realUser() && em == myEmail()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['lastSeen', 'lastRole', 'lastProject', 'projects', 'name']));
      allow delete: if (isOwner() && (resource.data.get('orgAdmin', false) == true || orgDeleting(resource.data.get('org', ''))))
                    || (isOrgAdmin() && inMyOrg(resource.data) && resource.data.get('orgAdmin', false) == false);
    }

    // ---- Client links: the client opens only the page whose secret link they have
    match /client/{token} {
      allow get: if signedIn();
      allow list: if (isMember() && inMyOrg(resource.data)) || ownerSpace(resource.data)
                  || (isOwner() && orgDeleting(resource.data.get('org', '')));
      allow create: if (canWrite() && inMyOrg(request.resource.data)) || ownerSpace(request.resource.data);
      allow delete: if (canWrite() && inMyOrg(resource.data)) || ownerSpace(resource.data)
                    || (isOwner() && orgDeleting(resource.data.get('org', '')));
      allow update: if (canWrite() && inMyOrg(resource.data) && inMyOrg(request.resource.data))
                    || (ownerSpace(resource.data) && ownerSpace(request.resource.data))
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['ap', 'ss', 'signed', 'log', 'clientAt', 'notes', 'docs']));
    }

    // ---- Files (photos, PDFs) until each company's own drive is connected
    match /photos/{id} {
      allow get: if signedIn();
      allow list: if (isMember() && inMyOrg(resource.data)) || ownerSpace(resource.data)
                  || (isOwner() && orgDeleting(resource.data.get('org', '')));
      allow create, update: if (canWrite() && inMyOrg(request.resource.data)) || ownerSpace(request.resource.data) || (signedIn() && !isMember() && !isOwner() && request.resource.data.get('org', '') == '');
      allow delete: if (canWrite() && inMyOrg(resource.data)) || ownerSpace(resource.data)
                    || (isOwner() && orgDeleting(resource.data.get('org', '')));
    }

    // Anything else: closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
